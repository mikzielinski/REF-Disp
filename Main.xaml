    <ui:InvokeCode DisplayName="Apply defaults and validate AI config" sap:VirtualizedContainerService.HintSize="700,164" sap2010:WorkflowViewState.IdRef="InvokeCode_ConfigDefaults" Language="VB">
      <ui:InvokeCode.Code><![CDATA[
If p_Config Is Nothing Then
    p_Config = New Dictionary(Of String, Object)()
End If

If Not p_Config.ContainsKey("logF_BusinessProcessName") Then p_Config("logF_BusinessProcessName") = "REF-Dispatcher"
If Not p_Config.ContainsKey("logF_SystemArea") Then p_Config("logF_SystemArea") = "Dispatcher"
If Not p_Config.ContainsKey("logF_Environment") Then p_Config("logF_Environment") = "DEV"
If Not p_Config.ContainsKey("OrchestratorQueueName") Then p_Config("OrchestratorQueueName") = "DispatcherQueue"
If Not p_Config.ContainsKey("OrchestratorQueueFolder") Then p_Config("OrchestratorQueueFolder") = ""
If Not p_Config.ContainsKey("SourceSystem") Then p_Config("SourceSystem") = "UNKNOWN"
If Not p_Config.ContainsKey("RunReportEnabled") Then p_Config("RunReportEnabled") = "True"
If Not p_Config.ContainsKey("RunReportOutputPath") Then p_Config("RunReportOutputPath") = "Data\Output\RunReport_{RunId}.json"
If Not p_Config.ContainsKey("RuntimeMode") Then p_Config("RuntimeMode") = "framework"

p_AIEnabled = "false"
p_AIProvider = "none"
p_AIConfigIssue = ""
p_RuntimeMode = "framework"

Try
    p_RuntimeMode = p_Config("RuntimeMode").ToString().ToLowerInvariant()
    If p_RuntimeMode <> "framework" AndAlso p_RuntimeMode <> "coded" Then
        p_RuntimeMode = "framework"
        p_Config("RuntimeMode") = "framework"
    End If
Catch
    p_RuntimeMode = "framework"
    p_Config("RuntimeMode") = "framework"
End Try

Try
    If p_Config.ContainsKey("AI") AndAlso p_Config("AI") IsNot Nothing Then
        Dim aiRoot As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(p_Config("AI").ToString())
        If aiRoot("Enabled") IsNot Nothing Then p_AIEnabled = aiRoot("Enabled").ToString().ToLowerInvariant()
        If aiRoot("Provider") IsNot Nothing Then p_AIProvider = aiRoot("Provider").ToString().ToLowerInvariant()
        If aiRoot("FallbackMode") Is Nothing Then aiRoot("FallbackMode") = "ruleBased"
        If aiRoot("AllowPII") Is Nothing Then aiRoot("AllowPII") = False
        If aiRoot("TimeoutSec") Is Nothing Then aiRoot("TimeoutSec") = 30
        If aiRoot("CostLimitPerRun") Is Nothing Then aiRoot("CostLimitPerRun") = 5.0
        If p_AIEnabled = "true" AndAlso p_AIProvider <> "none" Then
            If aiRoot("Providers") Is Nothing OrElse aiRoot("Providers")(p_AIProvider) Is Nothing Then
                p_AIConfigIssue = "Provider '" & p_AIProvider & "' missing in AI.Providers."
                p_AIEnabled = "false"
                p_AIProvider = "none"
            End If
        End If
        p_Config("AI") = aiRoot.ToString(Newtonsoft.Json.Formatting.None)
    End If
Catch ex As Exception
    p_AIEnabled = "false"
    p_AIProvider = "none"
    p_AIConfigIssue = "Invalid AI config: " & ex.Message
End Try
]]></ui:InvokeCode.Code>
