          <ui:CodeArgument Direction="In" Name="p_MaxTokens">
            <ui:CodeArgument.Value><InArgument x:TypeArguments="x:Int32">[int_MaxTokens]</InArgument></ui:CodeArgument.Value>
          </ui:CodeArgument>
