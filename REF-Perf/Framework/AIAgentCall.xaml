Dim jo As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(p_RawResponse)
Dim content As Newtonsoft.Json.Linq.JArray = CType(jo("content"), Newtonsoft.Json.Linq.JArray)
If content IsNot Nothing AndAlso content.Count > 0 Then
    p_AIResponse = content(0)("text").ToString()
Else
    p_AIResponse = p_RawResponse
End If
              ]]>
