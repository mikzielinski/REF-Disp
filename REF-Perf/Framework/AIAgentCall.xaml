    <ui:InvokeCode sap2010:Annotation.AnnotationText="Builds the Anthropic Messages API request body (JSON).&#xA;To use a different AI provider, update this code block to match their API schema." DisplayName="Build AI Request Body (Anthropic Messages API)" sap:VirtualizedContainerService.HintSize="920,180" sap2010:WorkflowViewState.IdRef="InvokeCode_Build" Language="VB">
      <ui:InvokeCode.Code>
        <![CDATA[
Dim request As New Newtonsoft.Json.Linq.JObject()
request("model") = p_ModelName
request("max_tokens") = p_MaxTokens
request("system") = p_SystemPrompt

Dim userMessage As New Newtonsoft.Json.Linq.JObject()
userMessage("role") = "user"
userMessage("content") = p_Prompt & vbCrLf & vbCrLf & "Transaction data:" & vbCrLf & p_ContextData

Dim messages As New Newtonsoft.Json.Linq.JArray()
messages.Add(userMessage)
request("messages") = messages

p_RequestBody = request.ToString(Newtonsoft.Json.Formatting.None)
        ]]>
