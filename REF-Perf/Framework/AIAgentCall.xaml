          <ui:InvokeCode sap2010:Annotation.AnnotationText="Parses the Anthropic Messages API response envelope and extracts the assistant text.&#xA;For other providers, update the JSON path to match their response schema." DisplayName="Parse AI Response (Anthropic schema)" sap:VirtualizedContainerService.HintSize="838,180" sap2010:WorkflowViewState.IdRef="InvokeCode_Parse" Language="VB">
