    <ui:InvokeCode sap2010:Annotation.AnnotationText="Parse the JSON config file. Loads Settings and Constants sections into the Config dictionary." DisplayName="Parse JSON: Settings and Constants" sap:VirtualizedContainerService.HintSize="539.2,180" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Language="VB">
      <ui:InvokeCode.Code>
        <![CDATA[
Dim jo As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(p_JsonText)
For Each section As String In New String() {"Settings", "Constants"}
    Dim tok As Newtonsoft.Json.Linq.JToken = jo(section)
    If tok IsNot Nothing Then
        For Each prop As Newtonsoft.Json.Linq.JProperty In CType(tok, Newtonsoft.Json.Linq.JObject).Properties()
            p_Config(prop.Name) = prop.Value.ToString()
        Next
    End If
Next
        ]]>
      </ui:InvokeCode.Code>
      <ui:InvokeCode.Parameters>
        <scg:List x:TypeArguments="ui:CodeArgument" Capacity="4">
