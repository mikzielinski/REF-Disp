            </ui:CodeArgument.Value>
          </ui:CodeArgument>
          <ui:CodeArgument Direction="InOut" Name="p_Config">
            <ui:CodeArgument.Value>
              <InOutArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)">[out_Config]</InOutArgument>
            </ui:CodeArgument.Value>
          </ui:CodeArgument>
        </scg:List>
      </ui:InvokeCode.Parameters>
    </ui:InvokeCode>
    <ui:InvokeCode sap2010:Annotation.AnnotationText="Builds a DataTable from the Assets array in Config.json. Columns: Name, Asset, OrchestratorAssetFolder. Used by the GetRobotAsset loop below." DisplayName="Build Assets DataTable from JSON" sap:VirtualizedContainerService.HintSize="539.2,180" sap2010:WorkflowViewState.IdRef="InvokeCode_2" Language="VB">
      <ui:InvokeCode.Code>
        <![CDATA[
Dim jo As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(p_JsonText)
Dim dt As New System.Data.DataTable()
dt.Columns.Add("Name")
dt.Columns.Add("Asset")
dt.Columns.Add("OrchestratorAssetFolder")
Dim assetsToken As Newtonsoft.Json.Linq.JToken = jo("Assets")
If assetsToken IsNot Nothing Then
    For Each item As Newtonsoft.Json.Linq.JToken In CType(assetsToken, Newtonsoft.Json.Linq.JArray)
        Dim assetObj As Newtonsoft.Json.Linq.JObject = CType(item, Newtonsoft.Json.Linq.JObject)
        Dim row As System.Data.DataRow = dt.NewRow()
        row("Name") = If(assetObj("Name") IsNot Nothing, assetObj("Name").ToString(), "")
        row("Asset") = If(assetObj("Asset") IsNot Nothing, assetObj("Asset").ToString(), "")
        row("OrchestratorAssetFolder") = If(assetObj("OrchestratorAssetFolder") IsNot Nothing, assetObj("OrchestratorAssetFolder").ToString(), "")
        dt.Rows.Add(row)
    Next
End If
p_Assets = dt
        ]]>
      </ui:InvokeCode.Code>
